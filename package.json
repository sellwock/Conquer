{
  "name": "conquer-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Possession-level Monte Carlo basketball game simulator (NBA + men's college) built on ESPN's public data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.7"
  }
}
