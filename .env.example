# Copy to .env and fill in. NEVER commit .env.
# Paper/replay/record modes need NONE of these. Only `doctor` and `live` do.

# Polygon private key of the wallet that funds trading (0x-prefixed).
POLYARB_PRIVATE_KEY=

# CLOB L2 API credentials. Derive them once with:  polyarb doctor --derive-creds
POLYARB_API_KEY=
POLYARB_API_SECRET=
POLYARB_API_PASSPHRASE=

# Polygon RPC used for merge/split and balance checks.
POLYARB_RPC_URL=https://polygon-rpc.com

# Optional: the funder/proxy wallet address if trading through a Polymarket proxy
# wallet rather than the EOA itself. Leave blank to use the EOA.
POLYARB_FUNDER_ADDRESS=
